{
  "name": "KOR: filterslist-KO DNS",
  "description": "A DNS version of filterslist-KO, a filter for websites in the Korean language",
  "homepage": "https://github.com/FilteringDev/filterslists-KO",
  "sources": [
    {
      "name": "List-KR 3rd_domains.txt",
      "source": "https://raw.githubusercontent.com/FilteringDev/filterslists-ko/refs/heads/master/filterslists/adblocking/filters-share/3rd_domains.txt",
      "type": "adblock",
      "transformations": [
        "RemoveModifiers",
        "Validate"
      ]
    },
    {
      "name": "List-KR 1st_domains.txt",
      "source": "https://raw.githubusercontent.com/FilteringDev/filterslists-ko/refs/heads/master/filterslists/adblocking/filters-share/1st_domains.txt",
      "type": "adblock",
      "transformations": [
        "RemoveModifiers",
        "Validate"
      ]
    }
  ],
  "transformations": [
    "RemoveComments",
    "Deduplicate",
    "Compress"
  ],
  "exclusions": [
    "||ad-api.band.us^",
    "*.veta.naver.com",
    "veta.naver.com"
  ]
}